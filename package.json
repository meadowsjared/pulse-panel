{
  "name": "pulse-panel",
  "private": true,
  "version": "0.31.30",
  "author": "Jared Meadows <meadowsjared@gmail.com>",
  "main": "src/electron/main/main.js",
  "description": "A soundboard app that looks nice too",
  "homepage": "https://github.com/meadowsjared/pulse-panel/blob/main/README.md",
  "scripts": {
    "dev": "bun app:dev",
    "build": "bun app:build",
    "preview": "bun app:preview",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "build:analyze": "bun vite:build --mode analyze",
    "ts": "tsc",
    "watch": "tsc -w",
    "lint": "eslint -c eslint.config.js ./src",
    "app:dev": "concurrently vite \"wait-on tcp:3000 && electron .\" \"tsc -w\"",
    "app:build": "bun vite:build && tsc && electron-builder",
    "app:preview": "bun vite:build && tsc && electron ."
  },
  "build": {
    "appId": "YourAppID",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "src/electron/**/*",
      "src/assets"
    ],
    "mac": {
      "artifactName": "${productName}_${version}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/pulse-panel_icon.ico",
      "artifactName": "${productName}_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "node_modules/regedit/vbs",
        "to": "regedit/vbs",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@meadowsjared/qhotkeys": "^1.1.18",
    "@meadowsjared/robotjs": "0.6.26",
    "@slosk/sudo-prompt": "^9.2.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "extract-zip": "^2.0.1",
    "idb": "^8.0.3",
    "lodash": "^4.18.1",
    "nconf": "^0.13.0",
    "pinia": "^4.0.3",
    "regedit": "^5.1.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-inline-svg": "^4.0.1",
    "vue3-colorpicker": "^2.3.0",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@evg3/vite-plugin-rewrite-all": "^1.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/lodash": "^4.17.25",
    "@types/nconf": "^0.10.7",
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "dmg-builder": "26.15.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "node-abi": "^4.35.0",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.2",
    "vue-router": "^5.3.1",
    "wait-on": "^9.5.1"
  }
}
